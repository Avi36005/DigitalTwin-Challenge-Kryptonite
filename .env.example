# Copy to .env (git-ignored) only if you need to override defaults. No secrets are required.
# API
GLUCOTWIN_HOME=                      # repository root (auto-detected)
GLUCOTWIN_RAW_DIR=                   # default: data/raw
GLUCOTWIN_PROCESSED_DIR=             # default: data/processed
GLUCOTWIN_ARTIFACTS_DIR=             # default: artifacts
GLUCOTWIN_VAR_DIR=                   # default: var (session/audit SQLite)
GLUCOTWIN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Web (apps/web)
GLUCOTWIN_API_URL=http://127.0.0.1:8000   # Vite dev/preview proxy target
VITE_GLUCOTWIN_TRANSPORT=http             # set to "fixtures" ONLY for explicit static-fixture UI development
